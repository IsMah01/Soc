# Copy this file to .env and replace every placeholder locally.
# Never commit .env or real credentials.

COMPOSE_PROJECT_NAME=mini-soc
ELASTIC_VERSION=8.15.0
ELASTIC_PASSWORD=replace_with_a_strong_password
ELASTIC_MEMORY=2g
KIBANA_PASSWORD=replace_with_a_strong_password
KIBANA_ENCRYPTION_KEY=replace_with_at_least_32_random_characters
LOGSTASH_PASSWORD=replace_with_a_strong_password

THEHIVE_VERSION=5.3
THEHIVE_SECRET=replace_with_a_long_random_secret
THEHIVE_ADMIN_PASSWORD=replace_with_a_strong_password
THEHIVE_API_KEY=replace_with_thehive_api_key
THEHIVE_NO_CONFIG=false
THEHIVE_NO_CONFIG_SECRET=replace_with_a_long_random_secret

LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=replace_with_llm_api_key

CORTEX_VERSION=3.1.1-1
CORTEX_SECRET=replace_with_a_long_random_secret
CORTEX_ADMIN_PASSWORD=replace_with_a_strong_password
CORTEX_URL=http://cortex:9001
CORTEX_API_KEY=replace_with_cortex_api_key

CASSANDRA_VERSION=4.1
CASSANDRA_CLUSTER_NAME=thp
CASSANDRA_PASSWORD=replace_with_a_strong_password
MINIO_ROOT_USER=replace_with_minio_user
MINIO_ROOT_PASSWORD=replace_with_a_strong_password
MINIO_REGION=us-east-1
REDIS_PASSWORD=replace_with_a_strong_password

SHUFFLE_VERSION=latest
SHUFFLE_OPENSEARCH_PASSWORD=replace_with_a_strong_password
SHUFFLE_ENCRYPTION_MODIFIER=replace_with_a_long_random_secret

MISP_ADMIN_PASSPHRASE=replace_with_a_strong_password
MISP_DB_PASSWORD=replace_with_a_strong_password
MISP_DB_ROOT_PASSWORD=replace_with_a_strong_password
MISP_REDIS_PASSWORD=replace_with_a_strong_password

NETWORK_SUBNET=172.28.0.0/16
TZ=Africa/Casablanca
